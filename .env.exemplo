DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mysql
# MySQL local/remoto (usado quando DATABASE_URL não estiver definida)
MYSQL_DATABASE=barbearia_db
MYSQL_USER=root
MYSQL_PASSWORD=COLOQUE_SUA_SENHA_AQUI
MYSQL_HOST=localhost
MYSQL_PORT=3306
# PostgreSQL local: use DB_ENGINE=postgresql e configure POSTGRES_*.
POSTGRES_DB=barbearia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=COLOQUE_SUA_SENHA_AQUI
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Banco PostgreSQL remoto, como Neon: esta URL tem prioridade sobre DB_ENGINE.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# POSTGRES_SSLMODE=require
# SQLite local opcional: use DB_ENGINE=sqlite.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para SMTP real: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=...
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=...